{
  "name": "portable-video-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "DSH bundle adding the Video Producer and Video Scene Worker agent presets plus studio skills that work from any workspace.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/**/*.md",
    "scripts/**/*.mjs",
    "AGENTS.md",
    "docs/*.md",
    "kit/*.json",
    "locale/*.json",
    "icon.svg",
    "library/catalog.json",
    "library/styles/README.md",
    "library/styles/default.json",
    "library/styles/indeterminate-forms/style.json",
    "library/styles/indeterminate-forms/notes.md",
    "library/styles/indeterminate-forms/reference.external.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "init:workspace": "node scripts/init-workspace.mjs",
    "studio:root": "node scripts/studio-root.mjs",
    "new:episode": "node scripts/new-episode.mjs",
    "validate": "node scripts/validate-episode.mjs",
    "release": "node scripts/validate-episode.mjs --release",
    "validate:narration": "node scripts/validate-narration.mjs",
    "validate:styles": "node scripts/validate-style-refs.mjs",
    "lint:narration": "node scripts/lint-narration.mjs",
    "editorial:review": "node scripts/editorial-review.mjs",
    "revise:narration": "node scripts/revise-narration.mjs",
    "promote:scene": "node scripts/promote-scene.mjs",
    "qa:media": "node scripts/qa-media.mjs",
    "qa:audio": "node scripts/qa-audio.mjs",
    "audio:preflight": "node scripts/audio-preflight.mjs",
    "metrics": "node scripts/collect-metrics.mjs",
    "validate:workers": "node scripts/validate-workers.mjs",
    "test": "node --test tests/*.test.mjs",
    "migrate:narration": "node scripts/migrate-narration.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
